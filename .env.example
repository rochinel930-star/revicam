# ── RéviCam — variables d'environnement ──────────────────────────────
# Copier ce fichier en `.env.local` puis remplir les valeurs.
# Inventaire complet et détaillé : docs/DEPLOYMENT.md.

# ── Supabase ─────────────────────────────────────────────────────────
# URL du projet Supabase (Dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xjzthitjhplgrsfdaial.supabase.co

# Clé publique "anon" (Dashboard → Settings → API → Project API keys → anon)
# Sûre à exposer côté client : la RLS limite ce qu'elle peut lire.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" (Dashboard → Settings → API → service_role)
# ⚠️ SECRÈTE. Jamais côté client. Utilisée par : les routes API serveur
# (correction, tentatives, ingestion, notation), le pipeline d'import
# (`npm run import`) et la génération d'artefacts (`npm run generate`).
SUPABASE_SERVICE_ROLE_KEY=

# ── IA (correction premium + génération) ─────────────────────────────
# Clé API Anthropic (console.anthropic.com → API Keys)
# ⚠️ SECRÈTE. Serveur uniquement : correction des réponses libres (Salle de
# Composition, questions ouvertes P8).
ANTHROPIC_API_KEY=

# ── Site ─────────────────────────────────────────────────────────────
# Origine publique du site (utilisée pour les liens absolus et la redirection
# du lien magique de connexion). Optionnel : repli sur https://revicam.vercel.app.
NEXT_PUBLIC_SITE_URL=https://revicam.vercel.app

# ── Administration (ingestion P4) ────────────────────────────────────
# Jeton d'accès aux routes /api/admin/* (ingestion, promotion). ⚠️ SECRET.
# S'il est ABSENT, l'administration est désactivée (503) — comportement sûr
# par défaut. À définir uniquement quand l'ingestion doit être exploitée.
ADMIN_API_TOKEN=

# ── Feature flags (optionnel) ────────────────────────────────────────
# Surcharge d'un flag sans redéploiement : FLAG_<CLÉ_MAJUSCULE>=1|0.
# Défauts au code (src/lib/flags.ts) ; surcharge possible aussi en base
# (table feature_flags). Exemple :
# FLAG_HEALTH_VERBOSE=1
